// =======================
// ENUMS
// =======================

enum StaffRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AppointmentPriority {
  NORMAL
  CRITICAL
}

enum BookingSource {
  ONLINE
  WALK_IN
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// =======================
// HOSPITAL
// =======================

model Hospital {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  phoneNumber  String?       @unique
  city         String
  state        String
  pinCode      String
  country      String
  address      String
  isActive     Boolean       @default(true)
  staff        Staff[]
  patients     Patient[]
  appointments Appointment[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// STAFF
// =======================

model Staff {
  id String @id @default(cuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  name           String
  email          String         @unique
  phone          String         @unique
  password       String
  role           StaffRole
  avatar         String?
  gender         Gender
  dob            DateTime?
  address        String?
  qualification  String?
  specialization String?
  experience     Int?
  status         StaffStatus    @default(ACTIVE)
  appointments   Appointment[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
}

// =======================
// PATIENT
// =======================

model Patient {
  id String @id @default(cuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  name         String
  phone        String        @unique
  gender       Gender
  address      String?
  appointments Appointment[]
  payments     Payment[]
  otp          OTP[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
}

// =======================
// APPOINTMENT
// =======================

model Appointment {
  id String @id @default(cuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  doctorId String
  doctor   Staff  @relation(fields: [doctorId], references: [id])

  tokenNumber      Int
  appointmentDate  DateTime
  appointmentTime  String
  followupDate     DateTime?
  bookingSource    BookingSource
  treatmentSummary String?
  priority         AppointmentPriority @default(NORMAL)
  notes            String?
  payment          Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
}

// =======================
// PAYMENT
// =======================

model Payment {
  id String @id @default(cuid())

  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  amount        Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @db.Decimal(10, 2)
  tax           Decimal?      @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus
  transactionId String?
  remarks       String?
  paymentDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hospitalId])
  @@index([patientId])
}

// =======================
// OTP
// =======================

model OTP {
  id String @id @default(cuid())

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  otp       String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([patientId])
}

// =======================
// NOTIFICATION
// =======================

model Notification {
  id String @id @default(cuid())

  userId    String
  user      Staff            @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
}
